---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import RecordTable from '../../components/RecordTable.astro';
import RecordFilter from '../../components/RecordFilter.tsx';

const allProjects = await getCollection('projects');
const rows = [...allProjects]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    ward: entry.data.ward,
    wardLabel: `Ward ${entry.data.ward}`,
    sector: entry.data.sector,
    dateDisplay: entry.data.dateDisplay,
    cost: entry.data.cost,
    status: entry.data.status,
  }));
---
<PageLayout
  title="The Record"
  description="Every project funded through DSIP and PSIP in Hagen Open since 2022, with cost, contractor, dates and status."
  path="/record/"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'The Record' }]}
>
  <div class="wrap">
    <div class="section-head" style="margin-top: 8px;">
      <h1>The Record</h1>
      <span class="meta">87 entries</span>
    </div>
    <p class="subtitle" style="margin-top: 10px;">
      Every project funded through DSIP and PSIP in Hagen Open since 2022, with cost, contractor, dates and status.
      Including the ones that are not finished.
    </p>

    <RecordFilter tableId="record-full-table" totalCount={rows.length} client:only="react" />

    <RecordTable rows={rows} tableId="record-full-table" />

    <p class="subtitle" style="margin-top: 16px;">
      Showing {rows.length} of 87 entries. Full dataset available on request from the district office.
    </p>
  </div>
</PageLayout>
