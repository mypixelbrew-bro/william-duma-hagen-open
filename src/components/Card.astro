---
interface Props {
  image: string | { src: string };
  alt: string;
  heading: string;
  body: string;
  href: string;
  linkText: string;
}
const { image, alt, heading, body, href, linkText } = Astro.props;
const src = typeof image === 'string' ? image : image.src;
---
<div class="card">
  <img class="card-photo" src={src} alt={alt} loading="lazy" width="1200" height="900" />
  <div class="card-body">
    <h3>{heading}</h3>
    <p>{body}</p>
    <a class="card-link" href={href}>{linkText}</a>
  </div>
</div>
