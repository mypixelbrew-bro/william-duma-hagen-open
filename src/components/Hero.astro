---
import { IMG_01 } from '../lib/images';

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  ctaHref: string;
  ctaLabel: string;
  caption: string;
}
const { eyebrow, heading, description, ctaHref, ctaLabel, caption } = Astro.props;
---
<div class="hero">
  <img class="hero-media" src={IMG_01.src ?? IMG_01} alt="" width="1600" height="900" fetchpriority="high" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <span class="hero-play" aria-hidden="true"></span>
  <div class="hero-content">
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1 class="hero-heading">{heading}</h1>
    <p class="hero-desc">{description}</p>
    <a class="btn btn-accent" href={ctaHref}>{ctaLabel}</a>
  </div>
</div>
<p class="caption hero-caption">{caption}</p>
