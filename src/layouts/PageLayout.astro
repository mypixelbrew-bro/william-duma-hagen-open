---
import BaseLayout from './BaseLayout.astro';
import UtilityBar from '../components/UtilityBar.astro';
import Nav from '../components/Nav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  breadcrumbs?: Crumb[];
}
const { title, description, path, ogImage, breadcrumbs } = Astro.props;
---
<BaseLayout title={title} description={description} path={path} ogImage={ogImage}>
  <UtilityBar />
  <Nav />
  {breadcrumbs && <Breadcrumb items={breadcrumbs} />}
  <main id="main">
    <slot />
  </main>
  <Footer />
</BaseLayout>
